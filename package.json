{
  "name": "jogstick-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -F @jogstick/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "engine:replay": "pnpm -F @jogstick/engine replay",
    "e2e": "tsx scripts/e2e.ts",
    "package:app": "tsx scripts/package-app.ts",
    "brand:check": "tsx brand/scripts/brand-check.ts",
    "brand:icons": "tsx brand/scripts/tray-icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
